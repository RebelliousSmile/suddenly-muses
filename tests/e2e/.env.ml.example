# Environment template for the full-config local Muse runner.
# Copy to a private .env file or export the variables before launching.

# Use the bootstrap cell populated by scripts/bootstrap_initial_cell.py.
MUSES_TABLE_DIR=tables/bootstrap_cell_medfan_combat_hostile_solennel_colere

# Local persistence for feedback / snapshots.
MUSES_FEEDBACK_DIR=.muses/feedback
MUSES_SNAPSHOT_DIR=.muses/snapshots

# Local-only runner.
MUSES_BIND_HOST=127.0.0.1
MUSES_BIND_PORT=8001

# Full ML-mode defaults for phase 5.
MUSES_SIGNATURE_MODE=stub
MUSES_ENCODER=sentence_transformer
MUSES_ENCODER_MODEL=paraphrase-multilingual-MiniLM-L12-v2
MUSES_LOG_FORMAT=json
MUSES_LOG_LEVEL=INFO
MUSES_SIGNATURE_MAX_AGE_SECONDS=300
MUSES_RATE_LIMIT_PER_MINUTE=60

# Optional: set only if you want to exercise admin endpoints locally.
# MUSES_ADMIN_TOKEN=

# Recommended install for this mode:
#   pip install -e .[api,embeddings]
