# Suddenly Muses — variables d'environnement
# Copier en .env et adapter avant de lancer le service.

# ---------------------------------------------------------------------------
# Chemins de persistance
# ---------------------------------------------------------------------------

# Répertoire contenant les fichiers JSONL des tables servies par le service.
# Chaque sous-dossier correspond à une cellule contextuelle.
MUSES_TABLE_DIR=tables/bootstrap_cell_medfan_combat_hostile_solennel_colere

# Répertoire des stores feedback (trust, profil de style, online learner,
# event log). Sera créé si absent.
MUSES_FEEDBACK_DIR=feedback

# Répertoire des snapshots horodatés (rollback). Sera créé si absent.
MUSES_SNAPSHOT_DIR=snapshots

# ---------------------------------------------------------------------------
# Authentification
# ---------------------------------------------------------------------------

# Token requis pour les endpoints /v1/admin/* (header X-Admin-Token).
# Si vide, le service refuse de démarrer sauf si MUSES_BIND_HOST=127.0.0.1.
MUSES_ADMIN_TOKEN=

# Mode de vérification ActivityPub des requêtes entrantes.
#   stub  — parse uniquement le header Signature, pas de crypto (dev seul)
#   strict — vérif RSA-SHA256 + fetch actor + anti-replay (production)
MUSES_SIGNATURE_MODE=stub

# Fenêtre anti-replay (secondes) — rejette les requêtes dont l'en-tête Date
# est plus ancien que cette valeur. Ignoré si MUSES_SIGNATURE_MODE=stub.
MUSES_SIGNATURE_MAX_AGE_SECONDS=300

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------

# Encodeur d'embeddings utilisé en production.
#   stub               — déterministe, sans dépendance (dev/tests)
#   sentence_transformer — modèle CPU multilingue (production)
MUSES_ENCODER=sentence_transformer

# Nom du modèle sentence-transformers (ignoré si MUSES_ENCODER=stub).
MUSES_ENCODER_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Dimension du stub encoder (ignoré si MUSES_ENCODER=sentence_transformer).
MUSES_STUB_ENCODER_DIM=16

# ---------------------------------------------------------------------------
# Service HTTP
# ---------------------------------------------------------------------------

MUSES_BIND_HOST=127.0.0.1
MUSES_BIND_PORT=8000

# Rate limit par IP (requêtes / minute). 0 = désactivé.
MUSES_RATE_LIMIT_PER_MINUTE=60

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Niveau de log : DEBUG, INFO, WARNING, ERROR
MUSES_LOG_LEVEL=INFO

# Format : json (production) ou text (dev)
MUSES_LOG_FORMAT=text

# ---------------------------------------------------------------------------
# Relais narrateur /narrate (H2) — sert choix-narratifs, appelle un LLM.
# N'affecte PAS les routes /v1/suggest|analyze (sans LLM, CPU-only).
# ---------------------------------------------------------------------------

# Provider LLM (OpenAI-compatible) : together | fireworks | openrouter
SUPPORTING_PROVIDER=together
# Clé du provider choisi (une seule requise selon SUPPORTING_PROVIDER) :
TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# OPENROUTER_API_KEY=

# Modèle narrateur (abordable par défaut ; pas d'Anthropic par défaut).
MUSES_NARRATE_MODEL=Qwen/Qwen2.5-7B-Instruct
# Température > 0 pour diversifier les N candidats du best-of-N.
MUSES_NARRATE_TEMPERATURE=0.8
# Court : un beat, pas une page.
MUSES_NARRATE_MAX_TOKENS=256

# Auth + métrage du relais (H3). off = ouvert sans débit (dev).
#   stub   = décode le JWT sans vérifier la signature (dev/local)
#   strict = vérifie le JWT (HS256 secret partagé, ou RS256 clé publique — D18)
MUSES_NARRATE_AUTH_MODE=off
# Secret HS256 ou clé publique PEM RS256 (requis si AUTH_MODE=strict).
MUSES_NARRATE_JWT_SECRET=
MUSES_NARRATE_JWT_ALGORITHM=HS256
# Passer a RS256 quand MUSES_NARRATE_JWKS_ENABLED=true (voir plus bas).
# Liste blanche d'émetteurs (iss), séparés par des virgules. Vide = tous.
MUSES_NARRATE_JWT_ISSUERS=

# H5 (#89) - resolution asymetrique du JWK par iss (D18), alternative a
# MUSES_NARRATE_JWT_SECRET pour AUTH_MODE=strict : chaque instance emettrice
# publie sa cle publique a https://<iss>/.well-known/jwks.json ; le Hub la
# resout par iss puis kid, sans jamais detenir de cle privee. Voir
# scripts/mint_muse_token.py (reference issuer) et aidd_docs/memory/infrastructure.md.
#   true  = active la resolution JWK (necessite MUSES_NARRATE_JWT_ISSUERS non vide)
MUSES_NARRATE_JWKS_ENABLED=false
# Duree de vie du cache JWKS par issuer (secondes).
MUSES_NARRATE_JWKS_CACHE_TTL_SECONDS=3600

# H5 (#89, Phase 3, D-89.2) - solde de demarrage d'un wallet_key inconnu.
# Laisser VIDE/absent (recommande) pour un defaut qui depend du mode :
#   - AUTH_MODE=strict -> defaut 0 : un token validement signe mais jamais
#     credite recoit 402 quota_exhausted, PAS de credit gratuit. C'est le
#     vrai controle d'acces par utilisateur ; sans lui, connaitre un iss
#     autorise (ou le secret partage) suffisait a obtenir 1000 unites.
#   - AUTH_MODE=off/stub -> defaut 1000 (confort dev inchange).
# Si la variable est posee explicitement (meme egale a un des defauts
# ci-dessus), elle est respectee tel quel, quel que soit le mode - donc on
# PEUT choisir un free-tier strict non nul, mais c'est alors un choix
# produit assume (log de demarrage WARNING si strict + valeur > 0).
#
# Provisionnement explicite d'un wallet_key (une fois AUTH_MODE=strict) :
#   - programmatique : WalletStore(...).credit(wallet_key, montant)
#   - HTTP (optionnel, monte seulement si le wallet /narrate est configure) :
#     POST /v1/admin/narrate/credit {"wallet_key": "<iss>/<sub>", "amount": N}
#     avec le header X-Admin-Token: $MUSES_ADMIN_TOKEN -> {"wallet_key",
#     "balance"} (nouveau solde). Voir muses/api/admin.py.
MUSES_NARRATE_DEFAULT_GRANT=

# CORS du relais (H4) — origines navigateur autorisées, séparées par virgules.
# Vide = désactivé (l'appel CN→Hub est serveur-à-serveur, CORS inutile).
MUSES_NARRATE_CORS_ORIGINS=
